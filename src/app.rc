#include <windows.h>

1 ICON "icon.ico"
1 24   "app.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     1,0,0,0
PRODUCTVERSION  1,0,0,0
FILEFLAGSMASK   0x3fL
FILEFLAGS       0x0L
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "lohPlayer"
            VALUE "FileDescription",  "lohPlayer - offline audio player"
            VALUE "FileVersion",      "1.0.0.0"
            VALUE "InternalName",     "lohPlayer"
            VALUE "LegalCopyright",   "Public domain / MIT"
            VALUE "OriginalFilename", "lohPlayer.exe"
            VALUE "ProductName",      "lohPlayer"
            VALUE "ProductVersion",   "1.0.0.0"
            VALUE "Comments",         "Local playback only. Performs no network access."
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
